# 当前产品模式默认开启。账户、权限和计费均由本仓库提供，不需要启动 KunAI。
# 设为 false 可回到原有 BYOK 单机模式。
VITE_PLATFORM_MODE=true
VITE_PLATFORM_IMAGE_MODEL=gpt-image-2
VITE_PLATFORM_AGENT_MODEL=gpt-5.5
VITE_API_PROXY_AVAILABLE=true
VITE_API_PROXY_LOCKED=true

# KunAI Studio 自身服务。
PLATFORM_PORT=3001
PLATFORM_SYSTEM_NAME=KunAI Studio
# 生产环境必填，KunAI Studio 正式站点使用 https://image.kunai.one。
APP_ORIGIN=http://localhost:5173
# 留空时开发环境为 false、生产环境强制为 true。
PLATFORM_COOKIE_SECURE=
# 只有入口代理会清洗 X-Forwarded-For 时才开启。
PLATFORM_TRUST_PROXY=false

# 本地账户、Session 与权限。生产环境请生成至少 32 字符的随机密钥。
PLATFORM_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
PLATFORM_DB_PATH=data/kunai-studio.sqlite
# 已结算图片的响应会写入此目录，用于幂等重试和断线恢复；生产环境必须持久化并备份。
PLATFORM_RESULT_DIR=data/results
PLATFORM_SESSION_TTL_DAYS=30
PLATFORM_REGISTER_ENABLED=true
PLATFORM_ADMIN_EMAILS=admin@example.com
PLATFORM_DEFAULT_ROLE=1
PLATFORM_DEFAULT_GROUP=default
PLATFORM_ALLOWED_EMAIL_DOMAINS=
# 新注册用户赠送对话余额，单位为人民币；不赠送时设为 0。
PLATFORM_SIGNUP_CREDIT=0

# 邮箱验证码由本服务直接连接 SMTP；兼容旧配置中的 SMTP_SERVER/SMTP_ACCOUNT/SMTP_TOKEN 别名，
# 仅用于迁移环境变量，不会连接或启动 KunAI。
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=KunAI Studio <no-reply@example.com>
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000
PLATFORM_CODE_TTL_MINUTES=10
PLATFORM_CODE_COOLDOWN_SECONDS=60
PLATFORM_CODE_MAX_ATTEMPTS=5
PLATFORM_CODE_EMAIL_HOURLY_LIMIT=6
PLATFORM_CODE_EMAIL_DAILY_LIMIT=20
PLATFORM_CODE_IP_HOURLY_LIMIT=30
PLATFORM_CODE_IP_DAILY_LIMIT=100
PLATFORM_PASSWORD_HASH_CONCURRENCY=4

# 可选 Cloudflare Turnstile；两个值必须同时配置。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 你的第三方 OpenAI-compatible 中转平台。这里填写 API 根地址，服务端会追加
# images/generations、images/edits；API Key 只在服务端读取。
IMAGE_UPSTREAM_BASE_URL=https://relay.example.com/v1
IMAGE_UPSTREAM_API_KEY=replace-with-server-only-api-key
PLATFORM_IMAGE_MODEL=gpt-image-2
# 可选：按请求像素数自动路由 1K、2K、4K；未配置时统一使用 PLATFORM_IMAGE_MODEL。
PLATFORM_IMAGE_MODEL_1K=
PLATFORM_IMAGE_MODEL_2K=
PLATFORM_IMAGE_MODEL_4K=

# Agent 独立 OpenAI-compatible 上游。模型目录从 /models 动态发现，仅展示 gpt-* 模型。
AGENT_UPSTREAM_BASE_URL=https://agent-relay.example.com/v1
AGENT_UPSTREAM_API_KEY=replace-with-agent-server-only-api-key
PLATFORM_AGENT_MODEL=gpt-5.5
PLATFORM_AGENT_MAX_OUTPUT_TOKENS=4096
PLATFORM_AGENT_MODEL_DISCOVERY_TIMEOUT_MS=10000
# 可选的首次发现统一零售价；配置后新发现模型会自动启用，之后可在管理员后台逐个调整。
# 三项 token 价格均为人民币元/百万 token；单步预留为人民币元。
PLATFORM_AGENT_INPUT_PRICE_CNY_PER_M=15
PLATFORM_AGENT_CACHED_INPUT_PRICE_CNY_PER_M=1.5
PLATFORM_AGENT_OUTPUT_PRICE_CNY_PER_M=120
PLATFORM_AGENT_MAX_STEP_RESERVE_CNY=100
PLATFORM_AGENT_AUTO_ENABLE_MODELS=gpt-5.4,gpt-5.4-mini,gpt-5.5,gpt-5.6-luna,gpt-5.6-sol,gpt-5.6-terra
PLATFORM_AGENT_ROUND_STEP_LIMIT=16
PLATFORM_AGENT_INPUT_TOKEN_OVERHEAD=8192

# Tavily 独立搜索；固定使用 basic，每次成功搜索按下列人民币价格收费。
TAVILY_API_KEY=replace-with-tavily-server-only-api-key
PLATFORM_SEARCH_PRICE_CNY=0.10
PLATFORM_SEARCH_TIMEOUT_MS=15000
PLATFORM_SEARCH_MINUTE_LIMIT=10
PLATFORM_SEARCH_DAILY_LIMIT=100
PLATFORM_SEARCH_MAX_CONCURRENT=8
PLATFORM_SEARCH_ROUND_LIMIT=12

# 图片展示参考单价，单位为人民币。服务端强制 n=1，空图、非 2xx 和超时不扣次数。
# 计费优先级：仍在有效期内的历史会员（不限次）→ 生图次数；不再使用现金余额兜底。
# 会员套餐与次数包的价格在管理员「商品与定价」后台配置，不在此文件中设置。
IMAGE_UNIT_PRICE=0.50
PLATFORM_GENERATION_MIN_ROLE=1
PLATFORM_AGENT_MIN_ROLE=1
# 可选，逗号分隔；留空允许所有用户组。
PLATFORM_ALLOWED_GROUPS=

# Dulupay V2（RSA / SHA256WithRSA）。启用后，本站服务端直接创建支付订单；私钥不会下发前端。
DULUPAY_ENABLED=false
DULUPAY_API_BASE=https://api.dulupay.com
DULUPAY_PID=
# 商户私钥：PKCS#8 PEM 或去掉头尾与换行后的 Base64。
DULUPAY_MERCHANT_PRIVATE_KEY=
# Dulupay 平台公钥：X.509 PEM 或去掉头尾与换行后的 Base64。
DULUPAY_PLATFORM_PUBLIC_KEY=
# 必须是公网 HTTPS 地址，Dulupay 支付成功后会 GET 此接口，服务端返回纯文本 success。
DULUPAY_NOTIFY_URL=https://image.kunai.one/api/platform/payment/dulupay/notify
DULUPAY_RETURN_URL=https://image.kunai.one/
# qrcode 返回可供本站生成收款码的支付内容；jump 仅用于商户后台暂不支持二维码模式时兼容。
DULUPAY_METHOD=qrcode
DULUPAY_TIMEOUT_MS=10000
DULUPAY_TIMESTAMP_SKEW_SECONDS=300
PLATFORM_RECHARGE_MIN_CNY=1
PLATFORM_RECHARGE_MAX_CNY=5000

# 兼容旧的自建支付页与 HMAC webhook；使用 Dulupay 时保持为空。
PAYMENT_URL=
PAYMENT_WEBHOOK_SECRET=

# Relay 与结果存储限制。
PLATFORM_MAX_RELAY_BODY_MB=128
PLATFORM_MAX_AGENT_BODY_MB=4
PLATFORM_MAX_UPSTREAM_BODY_MB=128
# 成功响应必须能完整解码为 PNG、JPEG 或 WebP，且不能超过此像素数。
PLATFORM_MAX_IMAGE_PIXELS=40000000
# 可用空间低于此阈值时，在调用上游前拒绝新图片任务，不扣费。
PLATFORM_RESULT_MIN_FREE_MB=512
PLATFORM_MAX_CONCURRENT_RELAYS=24
PLATFORM_MAX_QUEUED_RELAYS_PER_USER=8
PLATFORM_QUEUE_TIMEOUT_MS=600000
PLATFORM_RELAY_TIMEOUT_MS=600000
PLATFORM_AUTH_RATE_WINDOW_MS=60000
PLATFORM_AUTH_RATE_LIMIT=30
